# ============================================================================
# Wormhole .gitignore — Rust / C / C++ / Go / Windows / macOS / Linux / editors
# ============================================================================

# --- Rust -------------------------------------------------------------------
/target/
**/target/
# Cargo.lock is committed: the workspace ships a binary (the harness) and
# reproducible builds matter more than library-style flexibility.
*.rlib
*.rmeta
*.dylib
*.so

# --- C / C++ -----------------------------------------------------------------
*.o
*.obj
*.a
*.lib
*.dylib
*.so
*.so.*
*.dll
*.exe
*.out
*.app
*.pdb
*.ilk
*.idb
*.exp
*.tlog
*.VC.db
*.VC.opendb
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
install_manifest.txt
compile_commands.json
build/
Build/
out/
obj/
bin/

# --- Go ---------------------------------------------------------------------
# (upstream reference only; kept git-ignored / pinned)
/vendor/
*.test
*.prof
*.exe~

# --- Binaries / captures -----------------------------------------------------
# Large captures belong in releases or are regenerated by scripts.
*.pcap
*.pcapng
*.cap
*.etl
*.trace
*.profdata
*.profraw
*.dmp
*.core
core.*

# --- Windows ----------------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
*.msi
*.msix
*.appx
*.cab
*.cer
*.pfx
*.p12
*.snk

# --- macOS ------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
*.dmg
*.pkg
*.ipa

# --- Linux ------------------------------------------------------------------
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# --- Editors / IDEs ----------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*.swn
./*.sublime-workspace
*.iml
*.code-workspace
.history/

# --- Python (harness helpers) ------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# --- Node (tooling) ----------------------------------------------------------
node_modules/

# --- Local config / secrets --------------------------------------------------
.env
.env.*
*.local.toml
secrets.*

# --- Third-party reference clones (pinned submodule instead) ----------------
third_party/
reference/

# --- Experiment scratch data (keep HYPOTHESIS/FINDINGS, ignore raw output) ---
exp_results/
exp_*/*.csv
exp_*/*.json
exp_*/*.log
exp_*/*.bin
exp_*/*.pcap
exp_*/*.pcapng
